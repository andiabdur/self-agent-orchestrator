# Copy this file to .env and edit values.
# .env will be loaded automatically by start.sh

# Authentication (browser will prompt for these)
WEB_USERNAME=admin
WEB_PASSWORD=ganti-password-ini

# Server bind
PORT=7000
HOST=0.0.0.0

# Claude
CLAUDE_BIN=/Users/andi/.local/bin/claude
AGENT_CWD=/Users/andi/DevOps Workload
CLAUDE_MODEL=sonnet
PERMISSION_MODE=bypassPermissions

# Engine (claude | opencode)
ENGINE=claude

# OpenCode (only needed when ENGINE=opencode)
# OPENCODE_BIN=/opt/homebrew/bin/lildax

# State directory (sessions, logs)
STATE_DIR=/Users/andi/.agent-web-terminal

# Multi-node: Friendly name for this machine (shown in sidebar)
# NODE_NAME=Laptop A

# Multi-node: Remote nodes to connect to (JSON array)
# NODES=[{"id":"laptop-b","name":"Laptop B","url":"http://192.168.1.5:7000","username":"admin","password":"secret"}]
